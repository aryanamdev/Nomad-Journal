# Required
MONGO_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/nomad-journal
JWT_SECRET=generate-a-long-random-string   # e.g. `openssl rand -hex 32`

# Public URL of the app (used in verification emails and link previews)
DOMAIN=http://localhost:3000

# Optional: email verification. Without these, new accounts are verified automatically.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Nomad Journal <hello@example.com>"
